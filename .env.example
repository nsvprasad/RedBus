# AI Model Inference Backend: 'local' (llama.cpp) or 'huggingface'
LLM_BACKEND=local

# Local llama.cpp OpenAI-compatible API Configuration
LOCAL_LLM_URL=http://127.0.0.1:9931/v1/chat/completions
LOCAL_MODEL_NAME=Qwen2.5-1.5B-Instruct-GGUF

# Optional: Hugging Face API Configuration (only used if LLM_BACKEND=huggingface)
# Obtain your User Access Token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
